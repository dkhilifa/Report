<mxfile host="app.diagrams.net">
  <diagram id="ti-freertos" name="FreeRTOS scenarios">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="ST--TI FreeRTOS scenario architecture" style="text;html=1;align=center;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="btitle" value="Basic processing" style="text;html=1;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="25" as="geometry"/></mxCell>
        <mxCell id="b1" value="Worker, priority 3&#10;process 256 elements&#10;increment counter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="b2" value="Reporter, priority 4&#10;delay 30 s&#10;snapshot + UART" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="135" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="be" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ctitle" value="Cooperative scheduling" style="text;html=1;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="90" width="300" height="25" as="geometry"/></mxCell>
        <mxCell id="c1" value="Worker 0&#10;priority 1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="135" width="80" height="55" as="geometry"/></mxCell>
        <mxCell id="c2" value="Worker 1--3&#10;priority 1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="135" width="80" height="55" as="geometry"/></mxCell>
        <mxCell id="c3" value="Worker 4&#10;priority 1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="135" width="80" height="55" as="geometry"/></mxCell>
        <mxCell id="cr" value="Reporter, priority 2&#10;five counters / 30 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="225" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="ce1" value="yield" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce2" value="yield" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce3" value="snapshots" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="c2" target="cr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ptitle" value="Preemptive scheduling" style="text;html=1;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="330" height="25" as="geometry"/></mxCell>
        <mxCell id="pst" value="STM32C5&#10;workers p1--p5&#10;suspend / resume chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="135" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="pti" value="MSPM33&#10;workers p1--p5&#10;notification + ACK chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="135" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="pr" value="Reporter, priority 6&#10;five counters / 30 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="245" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="pe1" value="snapshots" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="pst" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe2" value="snapshots" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="pti" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Common settings: 1 kHz tick, preemption enabled, time slicing disabled, dynamic allocation, 8 KiB FreeRTOS heap.&#10;Runtime clocks differ: STM32C5 144 MHz; MSPM33 32 MHz." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="385" width="700" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
